#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 1 ]] || { echo "Usage: fan-control {enable|max|auto|full-speed}" >&2; exit 2; }
case "$1" in
  enable|max|auto|full-speed) ;;
  *) echo "Usage: fan-control {enable|max|auto|full-speed}" >&2; exit 2 ;;
esac

dmi=/sys/class/dmi/id/product_version
if [[ ! -r "$dmi" ]]; then
  echo "Fan control is only supported on ThinkPad T530 hardware." >&2
  exit 1
fi
product_version="$(<"$dmi")"
if [[ ! "${product_version,,}" =~ (^|[^a-z0-9])thinkpad[[:space:]]+t530([^a-z0-9]|$) ]]; then
  echo "Fan control is only supported on ThinkPad T530 hardware." >&2
  exit 1
fi

parameter=/sys/module/thinkpad_acpi/parameters/fan_control
if [[ ! -r "$parameter" ]] || [[ ! "$(<"$parameter")" =~ ^(Y|1)$ ]]; then
  if [[ -d /sys/module/thinkpad_acpi ]]; then
    /usr/bin/modprobe -r thinkpad_acpi || {
      echo "The kernel driver is busy; restart the computer to enable fan control." >&2
      exit 1
    }
  fi
  /usr/bin/modprobe thinkpad_acpi fan_control=1 || {
    /usr/bin/modprobe thinkpad_acpi || true
    echo "Could not load the ThinkPad fan driver." >&2
    exit 1
  }
fi
[[ -r "$parameter" && "$(<"$parameter")" =~ ^(Y|1)$ ]] || {
  echo "The kernel did not enable ThinkPad fan control." >&2
  exit 1
}
fan=/proc/acpi/ibm/fan
[[ -w "$fan" ]] || { echo "ThinkPad fan control is unavailable on this hardware." >&2; exit 1; }
case "$1" in
  enable) ;;
  max) printf 'level 7\n' > "$fan" ;;
  auto) printf 'level auto\n' > "$fan" ;;
  full-speed) printf 'level full-speed\n' > "$fan" ;;
esac
